{
  "name": "AI Republic Translator",
  "version": "1.0",
  "description": "Chrome extension + Svelte boilerplate",
  "manifest_version": 3,
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "options.html"
}